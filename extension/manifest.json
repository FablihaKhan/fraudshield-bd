{
  "manifest_version": 3,
  "name": "FraudShield BD Browser Shield",
  "short_name": "FraudShield",
  "version": "0.1.0",
  "description": "Stops passwords going to fake or unlocked pages, reveals clickjacking frames, blocks hidden cross-site form sends (CSRF) and flags attack links. Works offline.",
  "author": "Fabliha Afia",
  "homepage_url": "https://fablihakhan.github.io/fraudshield-bd/",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "FraudShield BD",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["main_world.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["lib.js", "strings.js", "content.js"], "run_at": "document_start" }
  ]
}
